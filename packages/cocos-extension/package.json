{
  "name": "agent-bridge",
  "package_version": 2,
  "version": "1.0.0-beta.1",
  "author": "InnoLotus Pty Ltd",
  "license": "Apache-2.0",
  "editor": ">=3.8.8",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc && esbuild source/main.ts --bundle --platform=node --format=cjs --target=node18 --outfile=dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@innolotus/cocos-act-node": "file:../act-node",
    "@innolotus/ivy-act-node-host": "0.1.0-alpha.2",
    "@innolotus/ivy-act-node-host-governance": "0.1.0-alpha.2",
    "@innolotus/ivy-act-node-protocol": "0.1.0-alpha.2",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cocos/creator-types": "^3.8.8",
    "@types/node": "^18.17.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.2"
  },
  "panels": {
    "default": {
      "title": "Agent Bridge",
      "type": "dockable",
      "main": "dist/panels/default",
      "size": {
        "min-width": 460,
        "min-height": 420,
        "width": 860,
        "height": 640
      }
    }
  },
  "contributions": {
    "menu": [
      {
        "path": "i18n:menu.panel/agent-bridge",
        "label": "Open Agent Bridge",
        "message": "open-panel"
      }
    ],
    "messages": {
      "open-panel": {
        "methods": [
          "openPanel"
        ]
      },
      "get-status": {
        "methods": [
          "getStatus"
        ]
      }
    }
  }
}
